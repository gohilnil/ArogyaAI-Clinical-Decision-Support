# ArogyaAI — environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
#
# The backend loads this file via python-dotenv from the repository root.

# ---------------------------------------------------------------------------
# Backend — required
# ---------------------------------------------------------------------------

# Google Gemini API key. SERVER-SIDE ONLY: this must never be exposed to the
# frontend (no VITE_ prefix) or committed to version control.
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Backend — optional (defaults shown; override only when needed)
# ---------------------------------------------------------------------------

# Firebase project whose ID tokens the API accepts. The token issuer and
# audience are both derived from this value.
FIREBASE_PROJECT_ID=arogyaai-cloud-ad667

# Require a verified Firebase ID token on protected routes. Set to `false` ONLY
# for local debugging — never in a deployment.
AROGYA_AUTH_REQUIRED=true

# Comma-separated list of browser origins allowed to call the API. A wildcard
# is intentionally not supported. Each entry must be the EXACT origin the site
# is served from (scheme + host, no trailing slash); a near-miss is a different
# origin and is rejected.
AROGYA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://arogya-ai-clinical-decision-support-nine.vercel.app

# Confidence below which the API returns "Inconclusive Data" instead of asking
# the LLM for a plan.
AROGYA_CONFIDENCE_THRESHOLD=35.0

# Comma-separated Gemini model fallback chain, tried in order.
AROGYA_GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash

# Path to the trained model artifact. Defaults to <repo root>/arogyaai_model.joblib.
# AROGYA_MODEL_PATH=

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local) — optional
# ---------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000

rules_version = '2';

// ArogyaAI Firestore security rules
// =================================
// Design principles:
//   * authentication != authorization. Being signed in grants nothing by itself.
//   * the client never chooses its own privilege. Registration can create a
//     `patient` outright; a `doctor` self-registers into a `pending` state that
//     only an admin can move out of.
//   * role and clinicId are immutable after creation, so privilege cannot be
//     escalated by updating an existing document.
//   * a patient document is a PERSON; an assessment is a CLINICAL EVENT.
//     Identity is not copied into assessments.
//   * clinical records are scoped to the clinic of the practitioner who owns them,
//     and a patient may read only their own record.
//
// Query compatibility: a list query is only authorized if the rule's conditions
// can be satisfied from the query's own constraints. Every collection query the
// UI issues therefore filters on `clinicId`, which is the field the rules check.
// Path-scoped reads (a patient's own subtree) need no filter. These exact
// patterns are probed against the running emulator in tests/rules/.
//
// Verified by the emulator suite in tests/rules/. See SECURITY.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The caller's own profile document. Costs one read per evaluation, and
    // throws (denying the request) when the profile does not exist, which is
    // the desired behaviour for a user without a provisioned account.
    function profile() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    // A practitioner is only a practitioner once APPROVED. Approval replaced
    // the invite system: a doctor self-registers into a `pending` state and an
    // admin promotes them. The default is 'approved' so accounts created before
    // the field existed keep working — reading a missing field with .get()
    // rather than a direct access also avoids the evaluation error that a
    // missing key would raise and deny everything.
    function doctorStatus() {
      return profile().get('status', 'approved');
    }

    function isDoctor() {
      return isSignedIn() && profile().role == 'doctor' && doctorStatus() == 'approved';
    }

    // True while a practitioner account exists but has not been approved yet.
    function isPendingDoctor() {
      return isSignedIn() && profile().role == 'doctor' && doctorStatus() == 'pending';
    }

    function isPatient() {
      return isSignedIn() && profile().role == 'patient';
    }

    // Admin is a platform operator, provisioned out-of-band. An admin manages
    // ACCOUNTS and ONBOARDING (who exists, which clinic they belong to, which
    // practitioners are approved) and deliberately gains
    // NOTHING over clinical data: patients, assessments and diaries stay
    // governed by the clinic rules below. Separation of duties — the operator
    // who can create an account still cannot read a patient's history.
    function isAdmin() {
      return isSignedIn() && profile().role == 'admin';
    }

    // The caller's clinic, or '' when they have none.
    //
    // Read with `.get(k, '')` rather than a direct `.clinicId`: an ADMIN has no
    // clinic field at all (an operator belongs to no clinic), and a direct read
    // of a missing key raises an evaluation error — which would deny every
    // request that touches this helper, not merely return false. An empty
    // string is also never a valid clinic id, so '' can only ever fail the
    // clinic comparisons below, which is the correct outcome for a role with no
    // clinic: it matches no real clinic's records.
    function myClinic() {
      return profile().get('clinicId', '');
    }

    // The patient record this account is linked to, or '' when unlinked.
    // A linked account may read exactly that patient's record and assessments.
    // The link is set by redeeming a clinician-issued patient code, so it acts
    // as a capability rather than something discoverable by enumeration.
    function myPatientId() {
      return profile().get('patientId', '');
    }

    function ownsPatient(patientId) {
      return isPatient() && myPatientId() != '' && myPatientId() == patientId;
    }

    function isClinicId(v) {
      return v is string && v.size() == 6;
    }

    // Whether an account's `clinicId` is acceptable FOR ITS ROLE.
    //
    // A patient or a doctor MUST carry a real 6-character clinic: it is the
    // tenancy boundary every clinical read is scoped by, so an account without
    // one would own records nothing could ever reach.
    //
    // An ADMIN must carry NONE. An operator works across every clinic and
    // belongs to none, so `clinicId` is not merely optional for an admin — it
    // is forbidden. Accepting one "just in case" would leave a field that
    // asserts a tenancy the role does not have, which is exactly the confusion
    // this removes: an admin's clinic meant nothing, was never read by any
    // rule, and appeared in the UI as though it did.
    //
    // Callers pass the field with `.get('clinicId', '')`, so an ABSENT key and
    // an empty string are both read as ''. That is what makes the requirement
    // enforceable: absence is the state we want, and a direct `.clinicId` read
    // would instead raise an evaluation error and deny the whole request.
    function clinicFieldOk(role, clinicId) {
      return role == 'admin' ? clinicId == '' : isClinicId(clinicId);
    }

    // An administrator carries no clinic AND no patient link. Both are tenancy
    // facts that belong to the patient/doctor roles; leaving a stale one behind
    // after promoting an account would be data that lingers but means nothing.
    function adminCarriesNoTenancy(data) {
      return data.get('clinicId', '') == '' && data.get('patientId', '') == '';
    }

        // A patient may only link to a patient record that exists and belongs to
    // the same clinic the account was registered into. An empty code unlinks.
    function validPatientLink(patientId, clinicId) {
      return patientId == ''
        || (
          exists(/databases/$(database)/documents/patients/$(patientId))
          && get(/databases/$(database)/documents/patients/$(patientId)).data.clinicId == clinicId
        );
    }

    // ---------- users ----------
    // A user may read only their own profile; an admin may read any profile,
    // because account management is what admin exists for. Creation is
    // constrained by role: `patient` is free, `doctor` SELF-REGISTERS into a
    // `pending` state that an admin later approves, and `admin` cannot be
    // self-assigned — an admin profile is provisioned out-of-band (console /
    // Admin SDK), so a compromised client cannot mint an operator account.
    //
    // The approval workflow replaced the invite system. A pending doctor is
    // still gated: isDoctor() is false until an admin sets status='approved',
    // so a pending account can read its own profile and nothing else.
    match /users/{userId} {
      allow read: if isSignedIn() && (userId == uid() || isAdmin());

      allow create: if isSignedIn()
        && userId == uid()
        && request.resource.data.email is string
        && clinicFieldOk(
             request.resource.data.get('role', ''),
             request.resource.data.get('clinicId', '')
           )
        && validPatientLink(
             request.resource.data.get('patientId', ''),
             request.resource.data.get('clinicId', '')
           )
        && (
          request.resource.data.role == 'patient'
          || (
            request.resource.data.role == 'doctor'
            && request.resource.data.status == 'pending'
          )
        );

      // role, clinicId and email are immutable to their OWNER: an update may
      // not change them, and a patient account may additionally (un)link
      // itself to a patient record within its own clinic. `status` is likewise
      // owner-immutable — otherwise a pending doctor could self-approve and
      // the approval workflow would be theatre.
      //
      // An admin may correct role, clinicId, email or status on ANY account,
      // because account management is exactly what the role exists for — a
      // mistyped clinic at registration otherwise strands the account
      // permanently (there is a live example). The admin path still requires
      // the account to remain internally consistent: a patient's patientId
      // must belong to the account's clinic, and the role and status must be
      // within their known sets.
      //
      // TENANCY IS CONDITIONAL ON ROLE, AND THAT IS THE WHOLE POINT.
      //
      //   * patient / doctor -> a real 6-character clinic is REQUIRED, because
      //     it is the boundary their clinical reads are scoped by; and a
      //     patient's link, when present, must resolve inside that clinic.
      //   * admin            -> a clinic is FORBIDDEN, and so is a patient
      //     link. An operator works across every clinic and belongs to none.
      //     Tolerating a value "just in case" would leave a field asserting a
      //     tenancy the role does not have — the exact confusion being removed.
      //
      // Promoting an account to admin therefore REQUIRES clearing its clinic
      // and link in the same write; the frontend does this with deleteField().
      allow update: if (
          (isSignedIn() && userId == uid()
            && request.resource.data.get('role', '') == resource.data.get('role', '')
            && request.resource.data.get('clinicId', '')
               == resource.data.get('clinicId', '')
            && request.resource.data.get('email', '') == resource.data.get('email', '')
            && request.resource.data.get('status', 'approved')
               == resource.data.get('status', 'approved')
            && (
              resource.data.get('role', '') == 'doctor'
              || validPatientLink(
                   request.resource.data.get('patientId', ''),
                   resource.data.get('clinicId', '')
                 )
            )
          )
          || (
            isAdmin()
            && request.resource.data.get('role', '') in ['patient', 'doctor', 'admin']
            && (
              request.resource.data.get('role', '') == 'admin'
                ? adminCarriesNoTenancy(request.resource.data)
                : (
                    isClinicId(request.resource.data.get('clinicId', ''))
                    && (
                      request.resource.data.get('role', '') != 'patient'
                      || validPatientLink(
                           request.resource.data.get('patientId', ''),
                           request.resource.data.get('clinicId', '')
                         )
                    )
                  )
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'role', 'clinicId', 'email', 'patientId', 'status'
               ])
            && request.resource.data.get('status', 'approved')
               in ['approved', 'pending', 'rejected']
          )
        );

      // The Auth account itself is removed through the Auth admin API; the
      // admin may clear the Firestore profile that belongs to it.
      allow delete: if isAdmin();
    }

    // ---------- patients ----------
    // Identity only: who the person is. No symptoms, no diagnosis — those are
    // clinical events and live in the assessments subcollection.
    match /patients/{patientId} {
      // A practitioner of the owning clinic, or the patient themself.
      allow read: if (isDoctor() && resource.data.clinicId == myClinic())
        || ownsPatient(patientId);

      allow create: if isDoctor()
        && request.resource.data.clinicId == myClinic()
        && request.resource.data.name is string
        && request.resource.data.createdBy == uid();

      // Who may correct a person's own details:
      //   * a practitioner of the owning clinic, or
      //   * the patient this record belongs to.
      //
      // The second case matters because a record is created by whoever registers
      // the patient and is often named before the patient ever links an account.
      // Without this, a patient who links to a record carrying someone else's
      // name had no way to correct it — the name was permanent and wrong.
      //
      // Both paths are confined to the identity fields below. `clinicId` and
      // `createdBy` can never change, so a patient cannot move their record to
      // another clinic or claim another practitioner created it, and the
      // `hasOnly` check stops any other field being smuggled in beside the edit.
      //
      // WHY .get() AND NOT A DIRECT FIELD READ
      // --------------------------------------
      // `createdBy` is absent on records created before it existed, and reading a
      // missing field raises an evaluation error — which denies the request. A
      // direct `request.resource.data.createdBy == resource.data.createdBy`
      // therefore rejected every edit to a legacy record, i.e. exactly the
      // records most likely to carry a wrong name. `.get(key, '')` reads safely,
      // and comparing the defaults means "absent" is preserved as "absent"
      // rather than being silently allowed to acquire a value.
      allow update: if (
          (isDoctor() && resource.data.clinicId == myClinic())
          || ownsPatient(patientId)
        )
        && request.resource.data.get('clinicId', '') == resource.data.get('clinicId', '')
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.name is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'age', 'gender', 'dosha', 'email',
             'heightCm', 'weightKg', 'updatedAt'
           ]);

      // Records are retained, not destroyed, so history stays auditable.
      allow delete: if false;
    }

    // ---------- assessments ----------
    // One clinical event: the symptoms and profile an analysis was run on, the
    // model's prediction and confidence, and the AI report. Append-only.
    match /patients/{patientId}/assessments/{assessmentId} {
      allow read: if (isDoctor() && resource.data.clinicId == myClinic())
        || ownsPatient(patientId);

      allow create: if isDoctor()
        && request.resource.data.clinicId == myClinic()
        && request.resource.data.createdBy == uid()
        && request.resource.data.patientId == patientId;

      // A clinical event is never rewritten or removed.
      allow update, delete: if false;
    }

    // Collection-group reads of assessments, used by the clinician dashboard to
    // count activity across a clinic. The query must filter on clinicId, which
    // is exactly what this rule checks.
    match /{path=**}/assessments/{assessmentId} {
      allow read: if isDoctor() && resource.data.clinicId == myClinic();
    }

    // ---------- patient_logs ----------
    // Symptom diary entries. A patient writes and reads only their own. A
    // practitioner reads the entries belonging to their clinic.
    match /patient_logs/{logId} {
      allow read: if isSignedIn() && (
        (resource.data.userId == uid())
        || (isDoctor() && resource.data.clinicId == myClinic())
      );

      // `clinicId` must be the writer's OWN clinic, taken from their profile.
      // It is not enough for it to be a string: a doctor reads every entry
      // whose clinicId matches their clinic, so an unbound clinicId let any
      // signed-in user write entries into another clinic's feed.
      allow create: if isSignedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.clinicId == myClinic();

      // An author may change their OWN entry in exactly two ways, and nothing
      // else.
      //
      //  (a) ATTACH it to the single patient record the account is linked to.
      //      Without this an entry written before the account was linked stays
      //      stranded: the entry has no patientId, so a practitioner opening it
      //      for analysis has no patient to prefill, and it never appears on the
      //      patient's own history. The affected-keys check confines this to
      //      `patientId`, and the value is pinned to the writer's own linked
      //      record rather than a caller-chosen id.
      //
      //  (b) EDIT the content of the entry — the words, the severity, the tags,
      //      the onset date. This is the "manage my own data" affordance: a
      //      patient who mistyped or wants to correct an entry could previously
      //      neither fix nor remove it. The allowlist stops the tenancy and
      //      author fields from moving, so an edit can never reassign the entry
      //      to another account or another clinic, and `userId`/`clinicId` are
      //      re-checked as unchanged. Severity is range-checked at the boundary
      //      (1–5) so a malformed value never lands in the record.
      //
      // Both branches are gated on the caller being the entry's author.
      allow update: if isSignedIn()
        && resource.data.userId == uid()
        && (
          (
            isPatient()
            && myPatientId() != ''
            && request.resource.data.patientId == myPatientId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientId'])
          )
          ||
          (
            request.resource.data.userId == resource.data.userId
            && request.resource.data.clinicId == resource.data.clinicId
            && request.resource.data.get('severity', 3) >= 1
            && request.resource.data.get('severity', 5) <= 5
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'symptoms', 'severity', 'tags', 'onset', 'updatedAt'
               ])
          )
        );

      // A patient may remove their OWN entry. Scoped to the author, so a
      // practitioner reading the clinic diary can never delete a patient's
      // words. Entries are otherwise retained.
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ---------- clinics ----------
    // A clinic is a real entity whose details a practitioner maintains: name,
    // address, contact, registration number. The document id IS the 6-character
    // clinic ID that accounts carry, so the two are the same thing rather than
    // needing a link — which is why the ID previously lived only on profiles
    // and had nowhere to record what the clinic actually is.
    //
    // Readable by the clinic's own practitioners and patients, and by an admin
    // for oversight. This grants an admin NO clinical data: clinic details are
    // organisational, and patients/assessments/diaries remain denied to admin.
    match /clinics/{clinicId} {
      allow read: if isSignedIn() && (
        ((isDoctor() || isPatient()) && myClinic() == clinicId)
        || isAdmin()
      );

      // A practitioner records their OWN clinic. The caller's profile must
      // already claim this clinic id, so a doctor cannot author a record for a
      // clinic they do not belong to.
      allow create: if isDoctor()
        && clinicId.size() == 6
        && myClinic() == clinicId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdBy == uid();

      // Details are editable by any practitioner of the clinic: a clinic is
      // shared, and its address or phone is not a per-person fact. The path id
      // is immutable by construction, `createdBy` is pinned so authorship
      // cannot be rewritten, and the allowlist stops any other field being
      // smuggled in beside the edit.
      allow update: if isDoctor()
        && myClinic() == clinicId
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'type', 'addressLine1', 'addressLine2', 'city', 'state',
             'postalCode', 'country', 'phone', 'email', 'registrationNo',
             'notes', 'updatedAt'
           ]);

      // A clinic is retained: deleting it would orphan every account and record
      // that carries its id.
      allow delete: if false;
    }

    // ---------- audit_logs ----------
    // An append-only record of administrative actions: who approved, rejected,
    // or edited which account, and what the previous value was.
    //
    // WHY A CLIENT-WRITTEN LOG IS STILL WORTH KEEPING
    // ----------------------------------------------
    // This is written by the admin's own client, so it is an accountability
    // trail rather than a tamper-proof one: an operator who bypassed the app
    // could write whatever they liked. It is honest about that. What it does
    // give — and what no amount of care in the panel could — is a record of the
    // actions taken THROUGH the product, which is the thing an audit asks for.
    // A hardened deployment would move this write server-side; that is a
    // follow-up, not something to claim now.
    //
    // The rules constrain it exactly as far as they can:
    //   * only an admin may write one, so a non-admin cannot forge entries;
    //   * the actor must be the caller's own uid, so an admin cannot attribute
    //     an action to somebody else;
    //   * entries are immutable once written, so history cannot be rewritten.
    match /audit_logs/{logId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.actorUid == uid()
        && request.resource.data.actorEmail is string
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.targetId is string
        && request.resource.data.at is timestamp;

      // An audit entry is a historical fact: never edited, never removed.
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
